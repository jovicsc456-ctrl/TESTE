{
  "name": "meu-mapa-doc",
  "version": "1.0.0",
  "description": "Mapa cinematográfico estilo Vox/documentário com Remotion",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "render": "remotion render MasterComposition out/documentario_final.mp4 --codec=h264 --crf=18",
    "render:gdp": "remotion render USGDPComposition out/pib_estados_eua.mp4 --codec=h264 --crf=18",
    "render:finance": "remotion render FinanceComposition out/juros_compostos.mp4 --codec=h264 --crf=18",
    "render:swiftshader": "remotion render MasterComposition out/documentario_final.mp4 --gl=swiftshader --concurrency=1",
    "flags": "node scripts/extract-flags.mjs",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/transitions": "^4.0.0",
    "@types/topojson-specification": "^1.0.5",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "us-state-flags": "^1.0.7",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.5.0"
  }
}
